# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so
*.pyd

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Local databases and logs
*.log
*.sqlite3
*.db
!data/default/*.db

# SoundFonts and user audio assets (keep large/copyrighted binary assets out of git)
soundfonts/*.sf2
soundfonts/*.SF2
recordings/
export/
*.wav
*.mp3
*.flac
!soundfonts/.gitkeep
